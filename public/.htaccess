# Polish Station — Apache config for cPanel shared hosting

RewriteEngine On

# Force HTTPS and canonical www host
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
RewriteRule ^ https://www.%1%{REQUEST_URI} [R=301,L]

# /aftercare was retired - its content moved into the Ceramic Coating and
# Graphene Coating service pages (plus a dedicated blog post once
# published). Permanent redirect so the old URL isn't left 404ing.
RewriteRule ^aftercare/?$ /services/ceramic-coating [R=301,L]

# Serve existing files/directories as-is; send everything else to the
# prerendered app shell so client-side routes still resolve.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ /index.html [L]

# Long-lived caching for hashed build assets, short for HTML
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# Gzip/Brotli compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# Explicit Cache-Control on top of the Expires headers above: hashed files
# under /assets/ (JS, CSS, fonts, images - the Vite build fingerprints all
# of them) never change without a new filename, so it's safe to tell
# browsers and proxies not to revalidate them for a year. HTML always
# revalidates so a new deploy is picked up immediately.
<IfModule mod_headers.c>
  <If "%{REQUEST_URI} =~ m#^/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>
