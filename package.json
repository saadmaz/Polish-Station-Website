{
  "name": "polish-station-website",
  "version": "1.1.3",
  "description": "Website for Polish Station, a premium automotive detailing studio in Sri Lanka: services, gallery, reviews and booking.",
  "homepage": "https://www.polishstation.lk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saadmaz/Polish-Station-Website.git"
  },
  "bugs": {
    "url": "https://github.com/saadmaz/Polish-Station-Website/issues"
  },
  "author": "Saad Mazhar (https://github.com/saadmaz)",
  "license": "UNLICENSED",
  "private": true,
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "dev": "vite dev",
    "build": "bun scripts/generate-sitemap.ts && vite build",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "preview:worker": "bun run build && wrangler dev",
    "deploy": "bun run build && wrangler deploy",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate:sitemap": "bun scripts/generate-sitemap.ts",
    "fetch:reviews": "bun scripts/fetch-google-reviews.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@portabletext/react": "^8.0.0",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@sanity/client": "^8.0.0",
    "@sanity/image-url": "^2.1.1",
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/react-router": "^1.168.25",
    "@tanstack/react-start": "^1.167.50",
    "@tanstack/router-plugin": "^1.167.28",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^12.18.0",
    "lucide-react": "^0.575.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.71.2",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.3.4",
    "vite-tsconfig-paths": "^6.0.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/node": "^22.16.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "nitro": "3.0.260603-beta",
    "prettier": "^3.7.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^7.3.1",
    "wrangler": "^4"
  }
}
