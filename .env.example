# Base URL of the OS's public intake API (see src/lib/api/os.ts). The
# contact, booking and newsletter forms POST here instead of to a third-party
# email relay - not a secret, just the address of a server we run.
VITE_OS_API_BASE_URL=https://os.polishstation.lk

# Google Places API key + Place ID, used only by scripts/fetch-google-reviews.ts
# at build time (never shipped to the client). Get these from Google Cloud
# Console (enable "Places API (New)") and your Google Business Profile listing.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# Firebase web app config for the OS's Firestore project (pos-polishstation).
# The contact form writes submissions straight into the "inquiries"
# collection so they show up on the OS's Inquiries screen. A Firebase web
# API key is a public app identifier, not a secret - get these from Firebase
# Console -> Project Settings -> General -> Your apps -> Web app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
