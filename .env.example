# Base URL of the POS's public intake API (see src/lib/api/pos.ts). The
# contact, booking and newsletter forms POST here instead of to a third-party
# email relay - not a secret, just the address of a server we run.
VITE_POS_API_BASE_URL=https://pos.polishstation.lk

# Google Places API key + Place ID, used only by scripts/fetch-google-reviews.ts
# at build time (never shipped to the client). Get these from Google Cloud
# Console (enable "Places API") and your Google Business Profile listing.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# Sanity project used for the /blog section. These are public, read-only
# identifiers (not secrets) - safe to ship to the client, same as any other
# Sanity CDN read. Get them from sanity.io/manage after creating a project
# (see studio/README.md). Leave unset and the blog renders an empty state.
VITE_SANITY_PROJECT_ID=52xh6awt
VITE_SANITY_DATASET=production
